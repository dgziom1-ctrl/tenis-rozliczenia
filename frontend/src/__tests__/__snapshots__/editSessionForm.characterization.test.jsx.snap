      <p style="color: var(--co-dim); font-family: var(--font-mono); font-size: 0.75rem; margin-top: 8px">
        "Zaznacz graczy, którzy przynieśli własną rakietkę — nie płacą za wypożyczenie"
      </p>
    </div>
    <div>
      <p style="align-items: center; color: var(--co-dim); display: flex; font-family: var(--font-display); font-size: 0.875rem; gap: 4px; letter-spacing: normal; margin-bottom: 8px; text-transform: none">
        <svg aria-hidden="true" class="lucide lucide-hand" fill="none" height="11" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" viewBox="0 0 24 24" width="11" xmlns="http://www.w3.org/2000/svg">
          <path d="M18 11V6a2 2 0 0 0-2-2a2 2 0 0 0-2 2" />
          <path d="M14 10V4a2 2 0 0 0-2-2a2 2 0 0 0-2 2v2" />
          <path d="M10 10.5V6a2 2 0 0 0-2-2a2 2 0 0 0-2 2v8" />
          <path d="M18 8a2 2 0 1 1 4 0v6a8 8 0 0 1-8 8h-2c-2.8 0-4.5-.86-5.99-2.34l-3.6-3.6a2 2 0 0 1 2.83-2.82L7 15" />
        </svg>
