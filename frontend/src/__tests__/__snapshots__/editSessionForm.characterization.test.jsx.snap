      <div style="display: flex; flex-direction: column; gap: 3px">
        <div style="align-items: baseline; display: flex; gap: 10px; justify-content: space-between" title="Cezary, Dorota">
          <span style="align-items: center; color: var(--co-cyan); display: inline-flex; font-family: var(--font-display); font-size: 0.75rem; gap: 4px; letter-spacing: normal; min-width: 0">
            <span>
              "Bez karty"
              <span style="color: var(--co-dim)">
                "· 2 os."
              </span>
            </span>
          </span>
          <span style="color: var(--co-cyan); font-family: var(--font-mono); font-size: 0.875rem; white-space: nowrap">
            "22,08 zł"
