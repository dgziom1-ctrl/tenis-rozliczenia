          "Dorota"
        </button>
      </div>
      <p style="color: var(--co-dim); font-family: var(--font-mono); font-size: 0.75rem; margin-top: 8px">
        "Zaznacz graczy, którzy przynieśli własną rakietkę — nie płacą za wypożyczenie"
      </p>
    </div>
    <div>
      <p style="align-items: center; color: var(--co-dim); display: flex; font-family: var(--font-display); font-size: 0.875rem; gap: 4px; letter-spacing: normal; margin-bottom: 8px; text-transform: none">
        <svg aria-hidden="true" class="lucide lucide-hand" fill="none" height="11" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" viewBox="0 0 24 24" width="11" xmlns="http://www.w3.org/2000/svg">
          <path d="M18 11V6a2 2 0 0 0-2-2a2 2 0 0 0-2 2" />
          <path d="M14 10V4a2 2 0 0 0-2-2a2 2 0 0 0-2 2v2" />
          <path d="M10 10.5V6a2 2 0 0 0-2-2a2 2 0 0 0-2 2v8" />
          <path d="M18 8a2 2 0 1 1 4 0v6a8 8 0 0 1-8 8h-2c-2.8 0-4.5-.86-5.99-2.34l-3.6-3.6a2 2 0 0 1 2.83-2.82L7 15" />
        </svg>
        "Wypożyczone rakiety"
      </p>
      <div style="align-items: center; display: flex; gap: 8px; margin-bottom: 10px">
        <label for="#id3" style="color: var(--co-dim); font-family: var(--font-mono); font-size: 0.75rem; white-space: nowrap">
          "Cena / szt.:"
        </label>
        <input aria-invalid="false" class="cyber-input" id="#id3" inputmode="decimal" style="clip-path: polygon(4px 0, 100% 0, calc(100% - 4px) 100%, 0 100%); font-family: var(--font-mono); padding: 8px; text-align: center; width: 78px" type="text" value="5" />
        <span style="color: var(--co-dim); font-family: var(--font-mono); font-size: 0.75rem">
          "zł"
        </span>
      </div>
      <div style="display: flex; flex-wrap: wrap; gap: 6px">
        <button aria-label="Liczba wypożyczonych rakiet: 0" aria-pressed="true" style="background: var(--co-tint-hi); border: 1px solid var(--co-cyan); box-shadow: 0 0 10px var(--co-tint-hi); clip-path: polygon(4px 0, 100% 0, calc(100% - 4px) 100%, 0 100%); color: var(--co-cyan); cursor: pointer; flex: 1 1 0%; font-family: var(--font-mono); font-size: 0.875rem; letter-spacing: normal; min-height: 44px; min-width: 44px; padding: 8px 4px; text-transform: none; transition: color 0.15s ease, background-color 0.15s ease, border-color 0.15s ease, box-shadow 0.15s ease" type="button">
          "0"
        </button>
        <button aria-label="Liczba wypożyczonych rakiet: 1" aria-pressed="false" style="background: var(--co-dark); border: 1px solid var(--co-border); clip-path: polygon(4px 0, 100% 0, calc(100% - 4px) 100%, 0 100%); color: var(--co-dim); cursor: pointer; flex: 1 1 0%; font-family: var(--font-mono); font-size: 0.875rem; letter-spacing: normal; min-height: 44px; min-width: 44px; padding: 8px 4px; text-transform: none; transition: color 0.15s ease, background-color 0.15s ease, border-color 0.15s ease, box-shadow 0.15s ease" type="button">
          "1"
        </button>
        <button aria-label="Liczba wypożyczonych rakiet: 2" aria-pressed="false" style="background: var(--co-dark); border: 1px solid var(--co-border); clip-path: polygon(4px 0, 100% 0, calc(100% - 4px) 100%, 0 100%); color: var(--co-dim); cursor: pointer; flex: 1 1 0%; font-family: var(--font-mono); font-size: 0.875rem; letter-spacing: normal; min-height: 44px; min-width: 44px; padding: 8px 4px; text-transform: none; transition: color 0.15s ease, background-color 0.15s ease, border-color 0.15s ease, box-shadow 0.15s ease" type="button">
          "2"
        </button>
        <button aria-label="Liczba wypożyczonych rakiet: 3" aria-pressed="false" style="background: var(--co-dark); border: 1px solid var(--co-border); clip-path: polygon(4px 0, 100% 0, calc(100% - 4px) 100%, 0 100%); color: var(--co-dim); cursor: pointer; flex: 1 1 0%; font-family: var(--font-mono); font-size: 0.875rem; letter-spacing: normal; min-height: 44px; min-width: 44px; padding: 8px 4px; text-transform: none; transition: color 0.15s ease, background-color 0.15s ease, border-color 0.15s ease, box-shadow 0.15s ease" type="button">
          "3"
        </button>
        <button aria-label="Liczba wypożyczonych rakiet: 4" aria-pressed="false" style="background: var(--co-dark); border: 1px solid var(--co-border); clip-path: polygon(4px 0, 100% 0, calc(100% - 4px) 100%, 0 100%); color: var(--co-dim); cursor: pointer; flex: 1 1 0%; font-family: var(--font-mono); font-size: 0.875rem; letter-spacing: normal; min-height: 44px; min-width: 44px; padding: 8px 4px; text-transform: none; transition: color 0.15s ease, background-color 0.15s ease, border-color 0.15s ease, box-shadow 0.15s ease" type="button">
          "4"
        </button>
      </div>
      <p style="color: var(--co-dim); font-family: var(--font-mono); font-size: 0.75rem; margin-top: 8px">
        "0 zł — nikt nie wypożycza rakiet"
      </p>
    </div>
    <div style="background: var(--co-tint); border: 1px solid var(--co-tint-line); clip-path: polygon(6px 0, 100% 0, calc(100% - 6px) 100%, 0 100%); padding: 10px 12px">
      <p style="color: var(--co-dim); font-family: var(--font-display); font-size: 0.875rem; letter-spacing: normal; margin-bottom: 6px; text-transform: none">
        "Po zmianie na osobę"
      </p>
      <div style="display: flex; flex-direction: column; gap: 3px">
        <div style="align-items: baseline; display: flex; gap: 10px; justify-content: space-between" title="Ala, Dorota">
          <span style="align-items: center; color: var(--co-cyan); display: inline-flex; font-family: var(--font-display); font-size: 0.75rem; gap: 4px; letter-spacing: normal; min-width: 0">
            <span>
              "Bez karty"
              <span style="color: var(--co-dim)">
                "· 2 os."
              </span>
            </span>
          </span>
          <span style="color: var(--co-cyan); font-family: var(--font-mono); font-size: 0.875rem; white-space: nowrap">
            "30,00 zł"
          </span>
        </div>
        <div style="align-items: baseline; display: flex; gap: 10px; justify-content: space-between" title="Bartek">
          <span style="align-items: center; color: var(--co-green); display: inline-flex; font-family: var(--font-display); font-size: 0.75rem; gap: 4px; letter-spacing: normal; min-width: 0">
            <svg aria-hidden="true" class="lucide lucide-zap" fill="none" height="11" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" style="flex-shrink: 0" viewBox="0 0 24 24" width="11" xmlns="http://www.w3.org/2000/svg">
              <path d="M4 14a1 1 0 0 1-.78-1.63l9.9-10.2a.5.5 0 0 1 .86.46l-1.92 6.02A1 1 0 0 0 13 10h7a1 1 0 0 1 .78 1.63l-9.9 10.2a.5.5 0 0 1-.86-.46l1.92-6.02A1 1 0 0 0 11 14z" />
            </svg>
            <span>
              "Multisport"
              <span style="color: var(--co-dim)">
                "· 1 os."
              </span>
            </span>
          </span>
          <span style="color: var(--co-green); font-family: var(--font-mono); font-size: 0.875rem; white-space: nowrap">
            "13,33 zł"
          </span>
        </div>
        <div style="align-items: baseline; display: flex; gap: 10px; justify-content: space-between" title="Cezary">
          <span style="align-items: center; color: var(--co-amber); display: inline-flex; font-family: var(--font-display); font-size: 0.75rem; gap: 4px; letter-spacing: normal; min-width: 0">
            <svg aria-hidden="true" class="lucide lucide-ticket" fill="none" height="11" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" style="flex-shrink: 0" viewBox="0 0 24 24" width="11" xmlns="http://www.w3.org/2000/svg">
              <path d="M2 9a3 3 0 0 1 0 6v2a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2v-2a3 3 0 0 1 0-6V7a2 2 0 0 0-2-2H4a2 2 0 0 0-2 2Z" />
              <path d="M13 5v2" />
              <path d="M13 17v2" />
              <path d="M13 11v2" />
            </svg>
            <span>
              "Medicover"
              <span style="color: var(--co-dim)">
                "· 1 os."
              </span>
            </span>
          </span>
          <span style="color: var(--co-amber); font-family: var(--font-mono); font-size: 0.875rem; white-space: nowrap">
            "21,67 zł"
          </span>
        </div>
      </div>
    </div>
    <div style="display: flex; gap: 10px">
      <button aria-label="Zapisz zmiany" class="cyber-button-yellow" style="align-items: center; display: flex; flex: 1 1 0%; gap: 6px; justify-content: center; padding: 10px">
        <svg aria-hidden="true" class="lucide lucide-check" fill="none" height="14" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" viewBox="0 0 24 24" width="14" xmlns="http://www.w3.org/2000/svg">
          <path d="M20 6 9 17l-5-5" />
        </svg>
        "Zapisz"
      </button>
      <button aria-label="Anuluj edycję" class="cyber-button-outline" style="align-items: center; display: flex; flex: 1 1 0%; gap: 6px; justify-content: center; padding: 10px">
        <svg aria-hidden="true" class="lucide lucide-x" fill="none" height="14" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" viewBox="0 0 24 24" width="14" xmlns="http://www.w3.org/2000/svg">
          <path d="M18 6 6 18" />
          <path d="m6 6 12 12" />
        </svg>
        "Anuluj"
      </button>
    </div>
  </div>
</div>
"
`;

exports[`EditSessionForm — charakteryzacja > stara sesja ping-pong: jedno pole kosztu kortu, bez limitu odbić 1`] = `
"
<div>
  <div style="display: flex; flex-direction: column; gap: 14px">
    <div>
      <span style="align-items: center; color: var(--co-dim); display: flex; font-family: var(--font-display); font-size: 0.875rem; gap: 4px; letter-spacing: normal; margin-bottom: 8px; text-transform: none">
        "Sport"
      </span>
      <div style="display: grid; gap: 6px; grid-template-columns: repeat(2, 1fr)">
        <button style="align-items: center; background: var(--co-tint-hi); border: 1px solid var(--co-tint-line); box-shadow: var(--glow-box-cyan); clip-path: polygon(4px 0, 100% 0, calc(100% - 4px) 100%, 0 100%); color: var(--co-cyan); cursor: pointer; display: inline-flex; font-family: var(--font-display); font-size: 0.8125rem; gap: 6px; justify-content: center; letter-spacing: normal; min-height: 44px; padding: 10px 6px; text-transform: none; transition: color 0.15s ease, background-color 0.15s ease, border-color 0.15s ease, box-shadow 0.15s ease" type="button">
          <svg aria-hidden="true" fill="none" focusable="false" height="15" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" viewBox="0 0 24 24" width="15">
            <circle cx="9.5" cy="10.5" r="6.4" />
            <path d="M14 15.2 19.4 20.4" stroke-width="2.6" />
            <circle cx="19.6" cy="4.6" fill="currentColor" r="1.9" stroke="none" />
          </svg>
          "Ping-Pong"
        </button>
        <button style="align-items: center; background: var(--co-dark); border: 1px solid var(--co-border); clip-path: polygon(4px 0, 100% 0, calc(100% - 4px) 100%, 0 100%); color: var(--co-dim); cursor: pointer; display: inline-flex; font-family: var(--font-display); font-size: 0.8125rem; gap: 6px; justify-content: center; letter-spacing: normal; min-height: 44px; padding: 10px 6px; text-transform: none; transition: color 0.15s ease, background-color 0.15s ease, border-color 0.15s ease, box-shadow 0.15s ease" type="button">
          <svg aria-hidden="true" fill="none" focusable="false" height="15" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" viewBox="0 0 24 24" width="15">
            <ellipse cx="9.6" cy="9.4" rx="4.3" ry="7" transform="rotate(-22 9.6 9.4)" />
            <path d="M12.8 15.6 20 21.2" stroke-width="2.6" />
            <circle cx="5" cy="20.4" fill="currentColor" r="1.6" stroke="none" />
          </svg>
          "Squash"
        </button>
        <button style="align-items: center; background: var(--co-dark); border: 1px solid var(--co-border); clip-path: polygon(4px 0, 100% 0, calc(100% - 4px) 100%, 0 100%); color: var(--co-dim); cursor: pointer; display: inline-flex; font-family: var(--font-display); font-size: 0.8125rem; gap: 6px; justify-content: center; letter-spacing: normal; min-height: 44px; padding: 10px 6px; text-transform: none; transition: color 0.15s ease, background-color 0.15s ease, border-color 0.15s ease, box-shadow 0.15s ease" type="button">
          <svg aria-hidden="true" fill="none" focusable="false" height="15" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" viewBox="0 0 24 24" width="15">
            <circle cx="12" cy="17.8" r="2.6" />
            <path d="M10.2 15.8 6.4 4.6M12 15.4V4M13.8 15.8l3.8-11.2" />
            <path d="M6.4 4.6 12 3.4l5.6 1.2" />
          </svg>
          "Badminton"
        </button>
        <button style="align-items: center; background: var(--co-dark); border: 1px solid var(--co-border); clip-path: polygon(4px 0, 100% 0, calc(100% - 4px) 100%, 0 100%); color: var(--co-dim); cursor: pointer; display: inline-flex; font-family: var(--font-display); font-size: 0.8125rem; gap: 6px; justify-content: center; letter-spacing: normal; min-height: 44px; padding: 10px 6px; text-transform: none; transition: color 0.15s ease, background-color 0.15s ease, border-color 0.15s ease, box-shadow 0.15s ease" type="button">
          <svg aria-hidden="true" fill="none" focusable="false" height="15" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" viewBox="0 0 24 24" width="15">
            <path d="M9.6 2.2c4 0 6.6 3.3 6.6 7.7 0 5-3 8.3-6.6 8.3S3 14.9 3 9.9c0-4.4 2.6-7.7 6.6-7.7Z" />
            <path d="M12.4 17 17.6 21.6" stroke-width="2.6" />
            <circle cx="9.6" cy="7.4" fill="currentColor" r="0.75" stroke="none" />
            <circle cx="6.9" cy="10.4" fill="currentColor" r="0.75" stroke="none" />
            <circle cx="12.3" cy="10.4" fill="currentColor" r="0.75" stroke="none" />
            <circle cx="9.6" cy="13.2" fill="currentColor" r="0.75" stroke="none" />
          </svg>
          "Padel"
        </button>
      </div>
    </div>
    <div class="field-pair">
      <div>
        <span style="color: var(--co-cyan); display: block; font-family: var(--font-display); font-size: 0.875rem; letter-spacing: normal; margin-bottom: 6px; text-transform: none">
          "Data"
        </span>
        <div class="cyber-date-wrap" style="position: relative">
          <div aria-hidden="true" class="cyber-input" style="align-items: center; clip-path: polygon(6px 0, 100% 0, calc(100% - 6px) 100%, 0 100%); display: flex; font-family: var(--font-mono); gap: 10px; justify-content: space-between; padding: 10px 12px; pointer-events: none; width: 100%">
            <span>
              "05.02.2025"
            </span>
            <svg aria-hidden="true" class="lucide lucide-calendar-days" fill="none" height="14" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" style="flex-shrink: 0; opacity: 0.4" viewBox="0 0 24 24" width="14" xmlns="http://www.w3.org/2000/svg">
              <path d="M8 2v4" />
              <path d="M16 2v4" />
              <rect height="18" rx="2" width="18" x="3" y="4" />
              <path d="M3 10h18" />
              <path d="M8 14h.01" />
              <path d="M12 14h.01" />
              <path d="M16 14h.01" />
              <path d="M8 18h.01" />
              <path d="M12 18h.01" />
              <path d="M16 18h.01" />
            </svg>
          </div>
          <input aria-label="Data sesji" max="2026-11-20" style="box-sizing: border-box; cursor: pointer; font-size: 16px; height: 100%; left: 0px; opacity: 0.01; padding: 0px; position: absolute; top: 0px; width: 100%; z-index: 2" type="date" value="2025-02-05" />
        </div>
      </div>
      <div>
        <label for="#id1" style="color: var(--co-cyan); display: block; font-family: var(--font-display); font-size: 0.875rem; letter-spacing: normal; margin-bottom: 6px; text-transform: none">
          "Koszt kortu"
        </label>
        <input aria-invalid="false" class="cyber-input" id="#id1" inputmode="decimal" style="clip-path: polygon(6px 0, 100% 0, calc(100% - 6px) 100%, 0 100%); padding: 10px 12px; width: 100%" type="text" value="45" />
        <p style="color: var(--co-dim); font-family: var(--font-mono); font-size: 0.75rem; margin: 6px 0px 0px">
          "Kwota za kort po odliczeniu wszystkich odbić kart"
        </p>
      </div>
    </div>
    <div style="display: flex; gap: 12px">
      <div style="flex: 1 1 0%">
        <span style="align-items: center; color: var(--co-dim); display: flex; font-family: var(--font-display); font-size: 0.875rem; gap: 4px; letter-spacing: normal; margin-bottom: 6px; text-transform: none">
          "Korty / stoły"
        </span>
        <div style="display: flex; gap: 6px">
          <button aria-pressed="false" style="background: var(--co-dark); border: 1px solid var(--co-border); clip-path: polygon(4px 0, 100% 0, calc(100% - 4px) 100%, 0 100%); color: var(--co-dim); cursor: pointer; flex: 1 1 0%; font-family: var(--font-mono); font-size: 0.875rem; letter-spacing: normal; min-height: 44px; padding: 8px 4px; text-transform: none; transition: color 0.15s ease, background-color 0.15s ease, border-color 0.15s ease, box-shadow 0.15s ease" type="button">
            "1"
          </button>
          <button aria-pressed="false" style="background: var(--co-dark); border: 1px solid var(--co-border); clip-path: polygon(4px 0, 100% 0, calc(100% - 4px) 100%, 0 100%); color: var(--co-dim); cursor: pointer; flex: 1 1 0%; font-family: var(--font-mono); font-size: 0.875rem; letter-spacing: normal; min-height: 44px; padding: 8px 4px; text-transform: none; transition: color 0.15s ease, background-color 0.15s ease, border-color 0.15s ease, box-shadow 0.15s ease" type="button">
            "2"
          </button>
          <button aria-pressed="false" style="background: var(--co-dark); border: 1px solid var(--co-border); clip-path: polygon(4px 0, 100% 0, calc(100% - 4px) 100%, 0 100%); color: var(--co-dim); cursor: pointer; flex: 1 1 0%; font-family: var(--font-mono); font-size: 0.875rem; letter-spacing: normal; min-height: 44px; padding: 8px 4px; text-transform: none; transition: color 0.15s ease, background-color 0.15s ease, border-color 0.15s ease, box-shadow 0.15s ease" type="button">
            "3"
          </button>
        </div>
        <p style="color: var(--co-dim); font-family: var(--font-mono); font-size: 0.75rem; margin-top: 6px">
          "> Stara sesja: bez limitu odbić"
        </p>
      </div>
      <div style="flex: 1 1 0%">
        <span style="align-items: center; color: var(--co-dim); display: flex; font-family: var(--font-display); font-size: 0.875rem; gap: 4px; letter-spacing: normal; margin-bottom: 6px; text-transform: none">
          "Godziny"
        </span>
        <div style="display: flex; gap: 6px">
          <button aria-pressed="false" style="background: var(--co-dark); border: 1px solid var(--co-border); clip-path: polygon(4px 0, 100% 0, calc(100% - 4px) 100%, 0 100%); color: var(--co-dim); cursor: pointer; flex: 1 1 0%; font-family: var(--font-mono); font-size: 0.875rem; letter-spacing: normal; min-height: 44px; padding: 8px 4px; text-transform: none; transition: color 0.15s ease, background-color 0.15s ease, border-color 0.15s ease, box-shadow 0.15s ease" type="button">
            "1h"
          </button>
          <button aria-pressed="false" style="background: var(--co-dark); border: 1px solid var(--co-border); clip-path: polygon(4px 0, 100% 0, calc(100% - 4px) 100%, 0 100%); color: var(--co-dim); cursor: pointer; flex: 1 1 0%; font-family: var(--font-mono); font-size: 0.875rem; letter-spacing: normal; min-height: 44px; padding: 8px 4px; text-transform: none; transition: color 0.15s ease, background-color 0.15s ease, border-color 0.15s ease, box-shadow 0.15s ease" type="button">
            "2h"
          </button>
          <button aria-pressed="false" style="background: var(--co-dark); border: 1px solid var(--co-border); clip-path: polygon(4px 0, 100% 0, calc(100% - 4px) 100%, 0 100%); color: var(--co-dim); cursor: pointer; flex: 1 1 0%; font-family: var(--font-mono); font-size: 0.875rem; letter-spacing: normal; min-height: 44px; padding: 8px 4px; text-transform: none; transition: color 0.15s ease, background-color 0.15s ease, border-color 0.15s ease, box-shadow 0.15s ease" type="button">
            "3h"
          </button>
        </div>
        <p style="color: var(--co-dim); font-family: var(--font-mono); font-size: 0.75rem; margin-top: 6px">
          "> Wybierz korty i godziny, aby włączyć limit"
        </p>
      </div>
    </div>
    <div>
      <p style="align-items: center; color: var(--co-dim); display: flex; font-family: var(--font-display); font-size: 0.875rem; gap: 4px; letter-spacing: normal; margin-bottom: 8px; text-transform: none">
        <svg aria-hidden="true" class="lucide lucide-users" fill="none" height="11" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" viewBox="0 0 24 24" width="11" xmlns="http://www.w3.org/2000/svg">
          <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2" />
          <path d="M16 3.128a4 4 0 0 1 0 7.744" />
          <path d="M22 21v-2a4 4 0 0 0-3-3.87" />
          <circle cx="9" cy="7" r="4" />
        </svg>
        "Obecni"
      </p>
      <div class="player-grid">
        <button aria-pressed="true" style="background: var(--co-tint-hi); border: 1px solid var(--co-cyan); box-shadow: 0 0 10px var(--co-tint-hi); clip-path: polygon(4px 0, 100% 0, calc(100% - 4px) 100%, 0 100%); color: var(--co-cyan); cursor: pointer; font-family: var(--font-display); font-size: 0.875rem; letter-spacing: normal; min-height: 44px; padding: 10px 12px; text-transform: none; transition: color 0.15s ease, background-color 0.15s ease, border-color 0.15s ease, box-shadow 0.15s ease" type="button">
