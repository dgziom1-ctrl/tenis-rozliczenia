        <input aria-invalid="false" class="cyber-input" id="#id1" inputmode="decimal" style="clip-path: polygon(6px 0, 100% 0, calc(100% - 6px) 100%, 0 100%); padding: 10px 12px; width: 100%" type="text" value="60" />
        <p style="color: var(--co-dim); font-family: var(--font-mono); font-size: 0.75rem; margin: 6px 0px 0px">
