          "1"
        </button>
        <button aria-label="Liczba wypożyczonych rakiet: 2" aria-pressed="true" style="background: var(--co-tint-hi); border: 1px solid var(--co-cyan); box-shadow: 0 0 10px var(--co-tint-hi); clip-path: polygon(4px 0, 100% 0, calc(100% - 4px) 100%, 0 100%); color: var(--co-cyan); cursor: pointer; flex: 1 1 0%; font-family: var(--font-mono); font-size: 0.875rem; letter-spacing: normal; min-height: 44px; min-width: 44px; padding: 8px 4px; text-transform: none; transition: color 0.15s ease, background-color 0.15s ease, border-color 0.15s ease, box-shadow 0.15s ease" type="button">
          "2"
        </button>
        <button aria-label="Liczba wypożyczonych rakiet: 3" aria-pressed="false" style="background: var(--co-dark); border: 1px solid var(--co-border); clip-path: polygon(4px 0, 100% 0, calc(100% - 4px) 100%, 0 100%); color: var(--co-dim); cursor: pointer; flex: 1 1 0%; font-family: var(--font-mono); font-size: 0.875rem; letter-spacing: normal; min-height: 44px; min-width: 44px; padding: 8px 4px; text-transform: none; transition: color 0.15s ease, background-color 0.15s ease, border-color 0.15s ease, box-shadow 0.15s ease" type="button">
