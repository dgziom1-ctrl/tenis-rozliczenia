exports[`HistoryTab — charakteryzacja > widok mobilny: filtr gracza jako przycisk otwierający arkusz 1`] = `
"
<div>
  <div class="cyber-box" style="animation: slide-in-up 0.3s ease-out; clip-path: polygon(0 0, calc(100% - 20px) 0, 100% 20px, 100% 100%, 0 100%); padding: 20px 16px">
    <div style="align-items: center; border-bottom: 1px solid var(--co-border); display: flex; gap: 12px; margin-bottom: 24px; padding-bottom: 16px">
      <div style="background: var(--co-tint); border: 1px solid var(--co-green); clip-path: polygon(4px 0, 100% 0, calc(100% - 4px) 100%, 0 100%); padding: 6px 8px">
        <svg aria-hidden="true" class="lucide lucide-terminal" fill="none" height="16" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" style="color: var(--co-green); display: block" viewBox="0 0 24 24" width="16" xmlns="http://www.w3.org/2000/svg">
          <path d="M12 19h8" />
          <path d="m4 17 6-6-6-6" />
        </svg>
      </div>
      <div style="flex: 1 1 0%; min-width: 0">
        <h2 class="glitch-text" data-text="Historia" style="color: var(--co-green); font-family: var(--font-display); font-size: 1rem; letter-spacing: normal; margin: 0px; text-transform: none">
          "Historia"
        </h2>
      </div>
      <div style="flex-shrink: 0">
        <span style="color: var(--co-dim); font-family: var(--font-mono); font-size: 0.75rem">
          "14 rekordów"
        </span>
      </div>
    </div>
    <div style="margin-bottom: 24px">
      <div style="margin-bottom: 20px">
        <div style="align-items: center; display: flex; flex-wrap: wrap; gap: 10px; margin-bottom: 4px">
          <div style="background: var(--co-tint); border: 1px solid var(--co-tint-line); clip-path: polygon(4px 0, 100% 0, calc(100% - 4px) 100%, 0 100%); padding: 6px 8px">
            <svg aria-hidden="true" class="lucide lucide-trending-up" fill="none" height="14" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" style="color: var(--co-cyan); display: block" viewBox="0 0 24 24" width="14" xmlns="http://www.w3.org/2000/svg">
              <path d="M16 7h6v6" />
              <path d="m22 7-8.5 8.5-5-5L2 17" />
            </svg>
          </div>
          <span class="glitch-text" data-text="Trend frekwencji" style="color: var(--co-cyan); font-family: var(--font-display); font-size: 1.25rem; letter-spacing: normal; text-transform: none">
            "Trend frekwencji"
          </span>
          <div aria-hidden="true" style="background: linear-gradient(to right, var(--co-tint-line), transparent); flex: 1 1 0%; height: 1px; min-width: 20px" />
        </div>
      </div>
      <div style="background: var(--co-tint); border: 1px solid var(--co-border); clip-path: polygon(0 0, calc(100% - 12px) 0, 100% 12px, 100% 100%, 0 100%); overflow: hidden; position: relative">
        <svg aria-label="Wykres trendu frekwencji: 14 sesji od 1 sty do 2 kwi. Średnio 2.7 osoby, najwięcej 3, najmniej 2. Średni koszt 31.49 zł na osobę, najwyższy 40.84 zł." role="img" style="display: block; height: auto; width: 100%" viewBox="0 0 560 240">
          <defs>
            <lineargradient id="areaGrad" x1="0" x2="0" y1="0" y2="1">
              <stop offset="0%" stop-color="var(--co-cyan)" stop-opacity="0.12" />
              <stop offset="100%" stop-color="var(--co-cyan)" stop-opacity="0.01" />
            </lineargradient>
            <filter height="260%" id="lineGlow" width="140%" x="-20%" y="-80%">
              <fegaussianblur in="SourceGraphic" result="blur" stdDeviation="2.5" />
              <femerge>
                <femergenode in="blur" />
                <femergenode in="SourceGraphic" />
              </femerge>
            </filter>
          </defs>
          <g>
