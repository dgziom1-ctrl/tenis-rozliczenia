    <div style="display: flex; flex-direction: column; gap: 24px">
      <div>
        <div style="align-items: center; display: flex; gap: 10px; margin-bottom: 10px">
          <div style="align-items: center; background: var(--co-dark); border: 1px solid var(--co-border); clip-path: polygon(6px 0, 100% 0, calc(100% - 6px) 100%, 0 100%); display: flex; gap: 6px; padding: 4px 12px">
            <span style="color: var(--co-cyan); font-family: var(--font-display); font-size: 1rem; letter-spacing: normal; text-transform: none">
              "Kwiecień 2025"
            </span>
            <span style="color: var(--co-dim); font-family: var(--font-mono); font-size: 0.8125rem">
              "[1x]"
            </span>
          </div>
          <div style="background: linear-gradient(to right, var(--co-tint-line), transparent); flex: 1 1 0%; height: 1px" />
        </div>
        <div>
          <div class="glass-card glass-hover-lift log-entry scan-hover" style="clip-path: polygon(0 0, calc(100% - 8px) 0, 100% 8px, 100% 100%, 8px 100%, 0 calc(100% - 8px)); margin-bottom: 4px; padding: 12px 14px">
