              <button aria-label="Czas gry: 2 h" aria-pressed="true" style="background: var(--co-tint-hi); border: 1px solid var(--co-cyan); box-shadow: 0 0 10px var(--co-tint-hi); clip-path: polygon(4px 0, 100% 0, calc(100% - 4px) 100%, 0 100%); color: var(--co-cyan); cursor: pointer; flex: 1 1 0%; font-family: var(--font-mono); font-size: 0.875rem; letter-spacing: normal; min-height: 44px; padding: 8px 4px; text-transform: none; transition: color 0.15s ease, background-color 0.15s ease, border-color 0.15s ease, box-shadow 0.15s ease" type="button">
