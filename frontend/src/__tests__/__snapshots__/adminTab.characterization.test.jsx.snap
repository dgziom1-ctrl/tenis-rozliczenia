              <button aria-label="Liczba kortów: 2" aria-pressed="false" style="background: var(--co-dark); border: 1px solid var(--co-border); clip-path: polygon(4px 0, 100% 0, calc(100% - 4px) 100%, 0 100%); color: var(--co-dim); cursor: pointer; flex: 1 1 0%; font-family: var(--font-mono); font-size: 0.875rem; letter-spacing: normal; min-height: 44px; padding: 8px 4px; text-transform: none; transition: color 0.15s ease, background-color 0.15s ease, border-color 0.15s ease, box-shadow 0.15s ease" type="button">
                "2"
              </button>
              <button aria-label="Liczba kortów: 3" aria-pressed="false" style="background: var(--co-dark); border: 1px solid var(--co-border); clip-path: polygon(4px 0, 100% 0, calc(100% - 4px) 100%, 0 100%); color: var(--co-dim); cursor: pointer; flex: 1 1 0%; font-family: var(--font-mono); font-size: 0.875rem; letter-spacing: normal; min-height: 44px; padding: 8px 4px; text-transform: none; transition: color 0.15s ease, background-color 0.15s ease, border-color 0.15s ease, box-shadow 0.15s ease" type="button">
                "3"
              </button>
            </div>
            <p style="color: var(--co-dim); font-family: var(--font-mono); font-size: 0.75rem; margin-top: 6px">
