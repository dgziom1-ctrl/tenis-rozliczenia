            <svg aria-hidden="true" class="lucide lucide-users" fill="none" height="14" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" style="color: var(--co-cyan); flex-shrink: 0" viewBox="0 0 24 24" width="14" xmlns="http://www.w3.org/2000/svg">
