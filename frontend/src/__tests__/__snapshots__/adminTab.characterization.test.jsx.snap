            <button aria-pressed="true" style="background: var(--co-tint-green); border: 1px solid var(--co-green); box-shadow: 0 0 10px var(--co-tint-green); clip-path: polygon(4px 0, 100% 0, calc(100% - 4px) 100%, 0 100%); color: var(--co-green); cursor: pointer; font-family: var(--font-display); font-size: 0.875rem; letter-spacing: normal; min-height: 44px; padding: 10px 12px; text-transform: none; transition: color 0.15s ease, background-color 0.15s ease, border-color 0.15s ease, box-shadow 0.15s ease" type="button">
              "Bartek"
            </button>
            <button aria-pressed="true" style="background: var(--co-tint-green); border: 1px solid var(--co-green); box-shadow: 0 0 10px var(--co-tint-green); clip-path: polygon(4px 0, 100% 0, calc(100% - 4px) 100%, 0 100%); color: var(--co-green); cursor: pointer; font-family: var(--font-display); font-size: 0.875rem; letter-spacing: normal; min-height: 44px; padding: 10px 12px; text-transform: none; transition: color 0.15s ease, background-color 0.15s ease, border-color 0.15s ease, box-shadow 0.15s ease" type="button">
              "Cezary"
            </button>
            <button aria-pressed="true" style="background: var(--co-tint-green); border: 1px solid var(--co-green); box-shadow: 0 0 10px var(--co-tint-green); clip-path: polygon(4px 0, 100% 0, calc(100% - 4px) 100%, 0 100%); color: var(--co-green); cursor: pointer; font-family: var(--font-display); font-size: 0.875rem; letter-spacing: normal; min-height: 44px; padding: 10px 12px; text-transform: none; transition: color 0.15s ease, background-color 0.15s ease, border-color 0.15s ease, box-shadow 0.15s ease" type="button">
              "Dorota"
            </button>
            <button aria-pressed="false" style="background: var(--co-dark); border: 1px solid var(--co-border); clip-path: polygon(4px 0, 100% 0, calc(100% - 4px) 100%, 0 100%); color: var(--co-dim); cursor: pointer; font-family: var(--font-display); font-size: 0.875rem; letter-spacing: normal; min-height: 44px; padding: 10px 12px; text-transform: none; transition: color 0.15s ease, background-color 0.15s ease, border-color 0.15s ease, box-shadow 0.15s ease" type="button">
              "Ewa"
            </button>
          </div>
          <p style="color: var(--co-dim); font-family: var(--font-mono); font-size: 0.75rem; margin-top: 8px">
            "⚡ Multisport: zwrot 15 zł za każdą godzinę · 🎟️ Medicover: zwrot 15 zł raz na sesję. Kartę gracza (Multisport albo Medicover) ustawiasz w zakładce Gracze."
          </p>
          <p role="alert" style="color: var(--co-amber); font-family: var(--font-mono); font-size: 0.75rem; margin-top: 8px">
            "⚠ Limit 2 odbić na godzinę przekroczony — zniżka z każdej godziny zostanie proporcjonalnie podzielona na 4 osoby (7,50 zł/os. zamiast 15,00 zł)"
          </p>
        </div>
        <div style="display: flex; flex-direction: column; gap: 12px">
          <div>
            <label for="#id1" style="color: var(--co-dim); display: block; font-family: var(--font-display); font-size: 1rem; letter-spacing: normal; margin-bottom: 8px; text-transform: none">
              "Cena kortu z rezerwacji (zł)"
            </label>
            <p style="color: var(--co-dim); font-family: var(--font-mono); font-size: 0.75rem; margin: 0px 0px 8px 0px">
              "Kwota zapłacona przy rezerwacji, jeszcze przed zwrotem za karty. Rakiety doliczysz osobno."
            </p>
            <input aria-invalid="false" class="cyber-input" id="#id1" inputmode="decimal" placeholder="np. 56" style="clip-path: polygon(6px 0, 100% 0, calc(100% - 6px) 100%, 0 100%); padding: 10px 14px; width: 100%" type="text" value="" />
            <button style="background: transparent; border: 1px solid var(--co-border); clip-path: polygon(4px 0, 100% 0, calc(100% - 4px) 100%, 0 100%); color: var(--co-cyan); cursor: pointer; font-family: var(--font-mono); font-size: 0.75rem; margin-top: 8px; min-height: 44px; padding: 2px 10px" type="button">
              "Jak ostatnio: 100,00 zł (100,00 zł/kort/h)"
            </button>
          </div>
          <div style="background: var(--co-tint); border: 1px solid var(--co-tint-line); clip-path: polygon(6px 0, 100% 0, calc(100% - 6px) 100%, 0 100%); padding: 10px 12px">
            <div style="align-items: baseline; display: flex; gap: 8px; justify-content: space-between">
              <span style="color: var(--co-dim); font-family: var(--font-display); font-size: 0.875rem; letter-spacing: normal; text-transform: none">
                "Zwrot za karty na portfel"
              </span>
              <span style="color: var(--co-green); font-family: var(--font-mono); font-size: 0.875rem">
                "−30,00 zł"
              </span>
            </div>
            <div style="align-items: center; display: flex; flex-wrap: wrap; gap: 8px; margin-top: 4px">
              <p style="color: var(--co-dim); font-family: var(--font-mono); font-size: 0.75rem; margin: 0px">
                "Wg reguł: 2 × 15 zł za odbicia kart"
              </p>
              <button style="background: transparent; border: 1px solid var(--co-border); clip-path: polygon(4px 0, 100% 0, calc(100% - 4px) 100%, 0 100%); color: var(--co-dim); cursor: pointer; font-family: var(--font-mono); font-size: 0.75rem; min-height: 44px; padding: 2px 8px" type="button">
                "Zmień"
              </button>
            </div>
          </div>
        </div>
        <div>
          <button disabled="" style="align-items: center; background: var(--co-panel); border: 1px solid var(--co-border); color: var(--co-dim); cursor: not-allowed; display: flex; font-family: var(--font-display); font-size: 0.8125rem; gap: 8px; justify-content: center; letter-spacing: normal; padding: 14px 20px; width: 100%" type="submit">
            <svg aria-hidden="true" class="lucide lucide-circle-check" fill="none" height="16" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" viewBox="0 0 24 24" width="16" xmlns="http://www.w3.org/2000/svg">
              <circle cx="12" cy="12" r="10" />
              <path d="m9 12 2 2 4-4" />
            </svg>
            "Zapisz sesję"
          </button>
          <p style="color: var(--co-dim); font-family: var(--font-mono); font-size: 0.75rem; margin-top: 8px; text-align: center">
            "⚠ Zmień datę lub sport — sesja już istnieje"
          </p>
        </div>
      </form>
    </div>
  </div>
</div>
"
`;

exports[`AdminTab — charakteryzacja > padel z 2 kortami na 2 h, rakietami, własną rakietką i ceną kortu 1`] = `
