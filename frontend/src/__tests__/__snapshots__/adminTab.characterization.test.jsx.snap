// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`AdminTab — charakteryzacja > nowa sesja startuje składem, sportem, kortami i godzinami z ostatniej sesji 1`] = `
"
<div>
  <div style="animation: slide-in-up 0.3s ease-out; display: flex; flex-direction: column; gap: 16px; margin: 0px auto; max-width: 680px; width: 100%">
    <div class="cyber-box" style="clip-path: polygon(0 0, calc(100% - 20px) 0, 100% 20px, 100% 100%, 0 100%); padding: 20px 20px">
      <div style="align-items: center; border-bottom: 1px solid var(--co-border); display: flex; gap: 12px; margin-bottom: 24px; padding-bottom: 16px">
        <div style="background: var(--co-tint); border: 1px solid var(--co-cyan); clip-path: polygon(4px 0, 100% 0, calc(100% - 4px) 100%, 0 100%); padding: 6px 8px">
          <svg aria-hidden="true" class="lucide lucide-calendar-plus" fill="none" height="16" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" style="color: var(--co-cyan); display: block" viewBox="0 0 24 24" width="16" xmlns="http://www.w3.org/2000/svg">
            <path d="M16 19h6" />
            <path d="M16 2v4" />
            <path d="M19 16v6" />
            <path d="M21 12.598V6a2 2 0 0 0-2-2H5a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h8.5" />
            <path d="M3 10h18" />
            <path d="M8 2v4" />
          </svg>
        </div>
        <div style="flex: 1 1 0%; min-width: 0">
          <h2 class="glitch-text" data-text="Dodaj nową sesję" style="color: var(--co-cyan); font-family: var(--font-display); font-size: 1rem; letter-spacing: normal; margin: 0px; text-transform: none">
            "Dodaj nową sesję"
          </h2>
          <p style="color: var(--co-dim); font-family: var(--font-mono); font-size: 0.75rem; margin: 2px 0px 0px">
            "zapisz dzisiejszą grę w squasha"
          </p>
        </div>
      </div>
      <form style="display: flex; flex-direction: column; gap: 20px">
        <div>
          <span style="color: var(--co-dim); display: block; font-family: var(--font-display); font-size: 1rem; letter-spacing: normal; margin-bottom: 8px; text-transform: none">
            "Sport"
          </span>
          <div style="display: grid; gap: 6px; grid-template-columns: repeat(2, 1fr)">
            <button style="align-items: center; background: var(--co-dark); border: 1px solid var(--co-border); clip-path: polygon(4px 0, 100% 0, calc(100% - 4px) 100%, 0 100%); color: var(--co-dim); cursor: pointer; display: inline-flex; font-family: var(--font-display); font-size: 0.8125rem; gap: 6px; justify-content: center; letter-spacing: normal; min-height: 44px; padding: 10px 6px; text-transform: none; transition: color 0.15s ease, background-color 0.15s ease, border-color 0.15s ease, box-shadow 0.15s ease" type="button">
              <svg aria-hidden="true" fill="none" focusable="false" height="15" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" viewBox="0 0 24 24" width="15">
                <circle cx="9.5" cy="10.5" r="6.4" />
                <path d="M14 15.2 19.4 20.4" stroke-width="2.6" />
                <circle cx="19.6" cy="4.6" fill="currentColor" r="1.9" stroke="none" />
              </svg>
              "Ping-Pong"
            </button>
            <button style="align-items: center; background: var(--co-tint-hi); border: 1px solid var(--co-tint-line); box-shadow: var(--glow-box-cyan); clip-path: polygon(4px 0, 100% 0, calc(100% - 4px) 100%, 0 100%); color: var(--co-cyan); cursor: pointer; display: inline-flex; font-family: var(--font-display); font-size: 0.8125rem; gap: 6px; justify-content: center; letter-spacing: normal; min-height: 44px; padding: 10px 6px; text-transform: none; transition: color 0.15s ease, background-color 0.15s ease, border-color 0.15s ease, box-shadow 0.15s ease" type="button">
              <svg aria-hidden="true" fill="none" focusable="false" height="15" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" viewBox="0 0 24 24" width="15">
                <ellipse cx="9.6" cy="9.4" rx="4.3" ry="7" transform="rotate(-22 9.6 9.4)" />
                <path d="M12.8 15.6 20 21.2" stroke-width="2.6" />
                <circle cx="5" cy="20.4" fill="currentColor" r="1.6" stroke="none" />
              </svg>
              "Squash"
            </button>
            <button style="align-items: center; background: var(--co-dark); border: 1px solid var(--co-border); clip-path: polygon(4px 0, 100% 0, calc(100% - 4px) 100%, 0 100%); color: var(--co-dim); cursor: pointer; display: inline-flex; font-family: var(--font-display); font-size: 0.8125rem; gap: 6px; justify-content: center; letter-spacing: normal; min-height: 44px; padding: 10px 6px; text-transform: none; transition: color 0.15s ease, background-color 0.15s ease, border-color 0.15s ease, box-shadow 0.15s ease" type="button">
              <svg aria-hidden="true" fill="none" focusable="false" height="15" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" viewBox="0 0 24 24" width="15">
                <circle cx="12" cy="17.8" r="2.6" />
                <path d="M10.2 15.8 6.4 4.6M12 15.4V4M13.8 15.8l3.8-11.2" />
                <path d="M6.4 4.6 12 3.4l5.6 1.2" />
              </svg>
              "Badminton"
            </button>
            <button style="align-items: center; background: var(--co-dark); border: 1px solid var(--co-border); clip-path: polygon(4px 0, 100% 0, calc(100% - 4px) 100%, 0 100%); color: var(--co-dim); cursor: pointer; display: inline-flex; font-family: var(--font-display); font-size: 0.8125rem; gap: 6px; justify-content: center; letter-spacing: normal; min-height: 44px; padding: 10px 6px; text-transform: none; transition: color 0.15s ease, background-color 0.15s ease, border-color 0.15s ease, box-shadow 0.15s ease" type="button">
              <svg aria-hidden="true" fill="none" focusable="false" height="15" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" viewBox="0 0 24 24" width="15">
                <path d="M9.6 2.2c4 0 6.6 3.3 6.6 7.7 0 5-3 8.3-6.6 8.3S3 14.9 3 9.9c0-4.4 2.6-7.7 6.6-7.7Z" />
                <path d="M12.4 17 17.6 21.6" stroke-width="2.6" />
                <circle cx="9.6" cy="7.4" fill="currentColor" r="0.75" stroke="none" />
                <circle cx="6.9" cy="10.4" fill="currentColor" r="0.75" stroke="none" />
                <circle cx="12.3" cy="10.4" fill="currentColor" r="0.75" stroke="none" />
                <circle cx="9.6" cy="13.2" fill="currentColor" r="0.75" stroke="none" />
              </svg>
              "Padel"
            </button>
          </div>
        </div>
        <div style="display: flex; gap: 12px">
          <div style="flex: 1 1 0%">
            <span style="color: var(--co-dim); display: block; font-family: var(--font-display); font-size: 1rem; letter-spacing: normal; margin-bottom: 8px; text-transform: none">
              "Korty / stoły"
            </span>
            <div style="display: flex; gap: 6px">
              <button aria-label="Liczba kortów: 1" aria-pressed="false" style="background: var(--co-dark); border: 1px solid var(--co-border); clip-path: polygon(4px 0, 100% 0, calc(100% - 4px) 100%, 0 100%); color: var(--co-dim); cursor: pointer; flex: 1 1 0%; font-family: var(--font-mono); font-size: 0.875rem; letter-spacing: normal; min-height: 44px; padding: 8px 4px; text-transform: none; transition: color 0.15s ease, background-color 0.15s ease, border-color 0.15s ease, box-shadow 0.15s ease" type="button">
                "1"
              </button>
              <button aria-label="Liczba kortów: 2" aria-pressed="true" style="background: var(--co-tint-hi); border: 1px solid var(--co-cyan); box-shadow: 0 0 10px var(--co-tint-hi); clip-path: polygon(4px 0, 100% 0, calc(100% - 4px) 100%, 0 100%); color: var(--co-cyan); cursor: pointer; flex: 1 1 0%; font-family: var(--font-mono); font-size: 0.875rem; letter-spacing: normal; min-height: 44px; padding: 8px 4px; text-transform: none; transition: color 0.15s ease, background-color 0.15s ease, border-color 0.15s ease, box-shadow 0.15s ease" type="button">
                "2"
              </button>
              <button aria-label="Liczba kortów: 3" aria-pressed="false" style="background: var(--co-dark); border: 1px solid var(--co-border); clip-path: polygon(4px 0, 100% 0, calc(100% - 4px) 100%, 0 100%); color: var(--co-dim); cursor: pointer; flex: 1 1 0%; font-family: var(--font-mono); font-size: 0.875rem; letter-spacing: normal; min-height: 44px; padding: 8px 4px; text-transform: none; transition: color 0.15s ease, background-color 0.15s ease, border-color 0.15s ease, box-shadow 0.15s ease" type="button">
                "3"
              </button>
            </div>
            <p style="color: var(--co-dim); font-family: var(--font-mono); font-size: 0.75rem; margin-top: 6px">
              "Limit odbić: 4/h (2/kort/h)"
            </p>
          </div>
          <div style="flex: 1 1 0%">
            <span style="color: var(--co-dim); display: block; font-family: var(--font-display); font-size: 1rem; letter-spacing: normal; margin-bottom: 8px; text-transform: none">
              "Godziny"
            </span>
            <div style="display: flex; gap: 6px">
              <button aria-label="Czas gry: 1 h" aria-pressed="false" style="background: var(--co-dark); border: 1px solid var(--co-border); clip-path: polygon(4px 0, 100% 0, calc(100% - 4px) 100%, 0 100%); color: var(--co-dim); cursor: pointer; flex: 1 1 0%; font-family: var(--font-mono); font-size: 0.875rem; letter-spacing: normal; min-height: 44px; padding: 8px 4px; text-transform: none; transition: color 0.15s ease, background-color 0.15s ease, border-color 0.15s ease, box-shadow 0.15s ease" type="button">
                "1h"
              </button>
              <button aria-label="Czas gry: 2 h" aria-pressed="true" style="background: var(--co-tint-hi); border: 1px solid var(--co-cyan); box-shadow: 0 0 10px var(--co-tint-hi); clip-path: polygon(4px 0, 100% 0, calc(100% - 4px) 100%, 0 100%); color: var(--co-cyan); cursor: pointer; flex: 1 1 0%; font-family: var(--font-mono); font-size: 0.875rem; letter-spacing: normal; min-height: 44px; padding: 8px 4px; text-transform: none; transition: color 0.15s ease, background-color 0.15s ease, border-color 0.15s ease, box-shadow 0.15s ease" type="button">
                "2h"
              </button>
              <button aria-label="Czas gry: 3 h" aria-pressed="false" style="background: var(--co-dark); border: 1px solid var(--co-border); clip-path: polygon(4px 0, 100% 0, calc(100% - 4px) 100%, 0 100%); color: var(--co-dim); cursor: pointer; flex: 1 1 0%; font-family: var(--font-mono); font-size: 0.875rem; letter-spacing: normal; min-height: 44px; padding: 8px 4px; text-transform: none; transition: color 0.15s ease, background-color 0.15s ease, border-color 0.15s ease, box-shadow 0.15s ease" type="button">
                "3h"
              </button>
            </div>
            <p style="color: var(--co-dim); font-family: var(--font-mono); font-size: 0.75rem; margin-top: 6px">
              "2h × 4/h = maks. 8 odbić"
            </p>
          </div>
        </div>
        <div>
          <span style="color: var(--co-dim); display: block; font-family: var(--font-display); font-size: 1rem; letter-spacing: normal; margin-bottom: 8px; text-transform: none">
            "Data gry"
          </span>
          <div class="cyber-date-wrap" style="position: relative">
            <div aria-hidden="true" class="cyber-input" style="align-items: center; clip-path: polygon(6px 0, 100% 0, calc(100% - 6px) 100%, 0 100%); display: flex; font-family: var(--font-mono); gap: 10px; justify-content: space-between; padding: 10px 14px; pointer-events: none; width: 100%">
              <span>
                "15.06.2025"
              </span>
              <svg aria-hidden="true" class="lucide lucide-calendar-days" fill="none" height="14" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" style="flex-shrink: 0; opacity: 0.4" viewBox="0 0 24 24" width="14" xmlns="http://www.w3.org/2000/svg">
                <path d="M8 2v4" />
                <path d="M16 2v4" />
                <rect height="18" rx="2" width="18" x="3" y="4" />
                <path d="M3 10h18" />
                <path d="M8 14h.01" />
                <path d="M12 14h.01" />
                <path d="M16 14h.01" />
                <path d="M8 18h.01" />
                <path d="M12 18h.01" />
                <path d="M16 18h.01" />
              </svg>
            </div>
            <input aria-label="Data gry" max="2025-06-15" style="box-sizing: border-box; cursor: pointer; font-size: 16px; height: 100%; left: 0px; opacity: 0.01; padding: 0px; position: absolute; top: 0px; width: 100%; z-index: 2" type="date" value="2025-06-15" />
          </div>
        </div>
        <div class="glass-panel" style="clip-path: polygon(0 0, calc(100% - 12px) 0, 100% 12px, 100% 100%, 0 100%); padding: 16px">
          <p style="align-items: center; color: var(--co-text); display: flex; font-family: var(--font-display); font-size: 0.875rem; gap: 8px; letter-spacing: normal; margin-bottom: 12px; text-transform: none">
            <svg aria-hidden="true" class="lucide lucide-users" fill="none" height="14" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" style="color: var(--co-cyan); flex-shrink: 0" viewBox="0 0 24 24" width="14" xmlns="http://www.w3.org/2000/svg">
              <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2" />
              <path d="M16 3.128a4 4 0 0 1 0 7.744" />
              <path d="M22 21v-2a4 4 0 0 0-3-3.87" />
              <circle cx="9" cy="7" r="4" />
