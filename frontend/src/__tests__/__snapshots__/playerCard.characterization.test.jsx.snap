            </div>
          </div>
          <div style="background: var(--co-rose); border-radius: 50%; border: 2px solid var(--co-void); bottom: -2px; box-shadow: var(--glow-box-rose); height: 10px; position: absolute; right: -2px; width: 10px" title="Niezapłacone" />
        </div>
      </div>
      <div style="display: flex; flex-direction: column; flex: 1 1 0%; gap: 8px; justify-content: space-between; min-width: 0">
        <div>
          <h3 style="color: var(--co-text-hi); font-family: var(--font-display); font-size: clamp(1.5rem, 5vw, 1.85rem); letter-spacing: normal; line-height: 1; margin: 0px; overflow: hidden; text-overflow: ellipsis; text-transform: none; white-space: nowrap">
            "Ala"
          </h3>
          <div style="align-items: center; display: flex; flex-wrap: wrap; gap: 6px; margin-top: 6px">
            <div style="align-items: center; display: inline-flex; gap: 4px; position: relative">
              <button aria-expanded="false" aria-label="WETERAN 67% — ranga, pokaż próg następnej rangi" style="align-items: center; background: color-mix(in srgb, var(--rank-weteran) 6%, transparent); border: 1px solid color-mix(in srgb, var(--rank-weteran) 19%, transparent); clip-path: polygon(4px 0, 100% 0, calc(100% - 4px) 100%, 0 100%); cursor: pointer; display: inline-flex; gap: 4px; padding: 2px 6px 2px 4px; user-select: none" type="button">
                <svg aria-hidden="true" class="lucide lucide-award" fill="none" focusable="false" height="13" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" style="color: var(--rank-weteran); flex-shrink: 0" viewBox="0 0 24 24" width="13" xmlns="http://www.w3.org/2000/svg">
                  <path d="m15.477 12.89 1.515 8.526a.5.5 0 0 1-.81.47l-3.58-2.687a1 1 0 0 0-1.197 0l-3.586 2.686a.5.5 0 0 1-.81-.469l1.514-8.526" />
                  <circle cx="12" cy="8" r="6" />
                </svg>
                <span style="color: var(--rank-weteran); font-family: var(--font-display); font-size: 0.75rem; letter-spacing: normal; text-transform: none">
                  "WETERAN"
                </span>
                <span style="color: var(--rank-weteran); font-family: var(--font-mono); font-size: 0.75rem">
                  "67%"
                </span>
              </button>
            </div>
            <div style="align-items: center; background: var(--co-amber-dim); border: 1px solid var(--co-amber); clip-path: polygon(4px 0, 100% 0, calc(100% - 4px) 100%, 0 100%); display: inline-flex; gap: 4px; padding: 2px 6px">
              <svg aria-hidden="true" class="lucide lucide-flame" fill="none" height="11" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" style="color: var(--co-amber)" viewBox="0 0 24 24" width="11" xmlns="http://www.w3.org/2000/svg">
                <path d="M12 3q1 4 4 6.5t3 5.5a1 1 0 0 1-14 0 5 5 0 0 1 1-3 1 1 0 0 0 5 0c0-2-1.5-3-1.5-5q0-2 2.5-4" />
              </svg>
              <span style="color: var(--co-amber); font-family: var(--font-display); font-size: 0.75rem; letter-spacing: normal; text-transform: none">
                "seria 2"
              </span>
            </div>
          </div>
        </div>
        <div>
          <div style="align-items: baseline; display: flex; justify-content: space-between; margin-bottom: 4px">
            <span style="color: var(--co-dim); font-family: var(--font-mono); font-size: 0.75rem; letter-spacing: normal; text-transform: none">
              "Obecność"
            </span>
            <span style="color: var(--co-dim); font-family: var(--font-mono); font-size: 0.75rem">
              "2/3"
            </span>
          </div>
          <div style="background: var(--co-bar-track); height: 2px; overflow: hidden; position: relative">
            <div style="background: linear-gradient(90deg, var(--co-green), var(--co-cyan)); bottom: 0px; left: 0px; position: absolute; right: 0px; top: 0px; transform-origin: left center; transform: scaleX(0.67); transition: transform 0.8s ease" />
          </div>
          <div style="align-items: center; display: flex; flex-wrap: wrap; gap: 4px; margin-top: 6px" title="Ostatnie 3 sesji">
            <div style="background: transparent; border-radius: 50%; border: 1px solid var(--co-dot-empty); box-shadow: none; flex-shrink: 0; height: 7px; transition: background-color 0.2s ease, border-color 0.2s ease, box-shadow 0.2s ease; width: 7px" title="2025-02-26" />
            <div style="background: rgb(100, 127, 19); border-radius: 50%; border: 1px solid rgb(100, 127, 19); box-shadow: 0 0 4px #647F1380; flex-shrink: 0; height: 7px; transition: background-color 0.2s ease, border-color 0.2s ease, box-shadow 0.2s ease; width: 7px" title="2025-03-05" />
            <div style="background: rgb(100, 127, 19); border-radius: 50%; border: 1px solid rgb(100, 127, 19); box-shadow: 0 0 4px #647F1380; flex-shrink: 0; height: 7px; transition: background-color 0.2s ease, border-color 0.2s ease, box-shadow 0.2s ease; width: 7px" title="2025-03-12" />
          </div>
        </div>
      </div>
    </div>
    <div style="display: flex; flex-direction: column; flex: 1 1 0%; padding: 14px; position: relative; z-index: 1">
      <div aria-label="45,00zł — włącz tryb edycji wpłat" aria-pressed="false" role="button" style="align-items: center; background: var(--co-tint-rose); border: 1px solid var(--co-rose); clip-path: polygon(6px 0, 100% 0, calc(100% - 6px) 100%, 0 100%); cursor: default; display: flex; flex-direction: column; justify-content: center; margin-bottom: 10px; min-height: 84px; overflow: hidden; padding: 12px; position: relative; text-align: center; transition: background 0.2s ease, border-color 0.2s ease; user-select: none" tabindex="0">
        <div style="position: relative; z-index: 1">
          <p style="color: var(--co-rose); font-family: var(--font-tech); font-size: 2.5rem; font-style: italic; font-weight: 700; letter-spacing: normal; line-height: 1.1; margin: 0px; text-shadow: var(--glow-rose-md); text-transform: none">
            "45,00"
            <span style="color: var(--co-dim); font-family: var(--font-display); font-size: 1rem; letter-spacing: normal; margin-left: 4px; text-transform: none">
              "zł"
            </span>
          </p>
        </div>
      </div>
      <button aria-pressed="false" class="icon-btn" style="align-items: center; align-self: flex-end; background: transparent; color: var(--co-dim); cursor: pointer; display: inline-flex; font-family: var(--font-mono); font-size: 0.8125rem; gap: 6px; margin-bottom: 6px; min-height: 44px; padding: 6px 10px" type="button">
        <svg aria-hidden="true" class="lucide lucide-pencil" fill="none" height="13" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" viewBox="0 0 24 24" width="13" xmlns="http://www.w3.org/2000/svg">
          <path d="M21.174 6.812a1 1 0 0 0-3.986-3.987L3.842 16.174a2 2 0 0 0-.5.83l-1.321 4.352a.5.5 0 0 0 .623.622l4.353-1.32a2 2 0 0 0 .83-.497z" />
          <path d="m15 5 4 4" />
        </svg>
        "Edytuj wpłaty"
      </button>
      <div style="margin-bottom: 12px">
        <button aria-expanded="false" class="icon-btn" style="align-items: center; background: transparent; border: 1px solid var(--co-border); clip-path: polygon(4px 0, 100% 0, calc(100% - 4px) 100%, 0 100%); color: var(--co-cyan); cursor: pointer; display: flex; font-family: var(--font-display); font-size: 0.875rem; gap: 6px; justify-content: center; letter-spacing: normal; min-height: 44px; padding: 8px 10px; text-transform: none; width: 100%" type="button">
          <span aria-hidden="true" style="display: inline-flex; transform: none; transition: transform 0.25s">
            <svg aria-hidden="true" class="lucide lucide-chevron-down" fill="none" height="14" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" viewBox="0 0 24 24" width="14" xmlns="http://www.w3.org/2000/svg">
              <path d="m6 9 6 6 6-6" />
            </svg>
          </span>
          "Skąd ta kwota?"
        </button>
      </div>
      <div style="display: flex; flex-direction: column; gap: 8px; margin-top: auto">
        <button aria-describedby="~2" aria-label="45,00 zł — zapisz wpłatę" class="cyber-button-yellow hold-confirm-btn" style="padding: 10px 16px; width: 100%" type="button">
          <span aria-hidden="true" class="hold-confirm-fill" style="transform: scaleX(0); transition: transform 120ms ease-out" />
          <span style="align-items: center; display: flex; flex-direction: column; gap: 1px; position: relative; z-index: 1">
            <span style="font-family: var(--font-display); font-size: 1.25rem; letter-spacing: normal; line-height: 1">
              "45,00 zł"
            </span>
            <span id="~2" style="font-family: var(--font-mono); font-size: 0.75rem; letter-spacing: normal; opacity: 0.8">
              "Przytrzymaj, aby zapisać"
            </span>
          </span>
        </button>
        <p aria-live="polite" class="sr-only" role="status" />
        <button class="cyber-button-outline" style="min-height: 44px; padding: 8px 12px; width: 100%">
          "+ Inna kwota"
        </button>
      </div>
    </div>
  </div>
</div>
"
`;
