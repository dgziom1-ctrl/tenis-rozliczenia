# Skopiuj do `.env.local` i uzupełnij wartościami ze swojego projektu Firebase
# (Konsola Firebase → Ustawienia projektu → Twoje aplikacje → Konfiguracja SDK).
#
# W `npm run dev` bez `.env.local` działa `.env.development` z fikcyjnym projektem
# (UI się odpala, baza nie odpowie — do podglądu Wrapped użyj /dev/wrapped).
#
# UWAGA: wszystko z prefiksem VITE_ trafia do bundla i jest widoczne dla każdego,
# kto otworzy aplikację. Nie umieszczaj tu żadnych prawdziwych sekretów.
# Dostępu do danych pilnują reguły bazy (`database.rules.json`), a nie te zmienne.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=twoj-projekt.firebaseapp.com
VITE_FIREBASE_DATABASE_URL=https://twoj-projekt-default-rtdb.europe-west1.firebasedatabase.app
VITE_FIREBASE_PROJECT_ID=twoj-projekt
VITE_FIREBASE_STORAGE_BUCKET=twoj-projekt.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Klucz VAPID do powiadomień push (Konsola Firebase → Cloud Messaging →
# Certyfikaty push w internecie). Bez niego rejestracja push jest nieaktywna.
VITE_FIREBASE_VAPID_KEY=

# Kod odblokowujący panel administratora. To wyłącznie wygoda UI — kod jest
# widoczny w bundlu i NIE chroni danych.
VITE_ADMIN_PASSWORD=

# Numer telefonu pokazywany przy płatności BLIK.
VITE_BLIK_NUMBER=
