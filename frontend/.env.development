# Automatycznie wczytywany w `npm run dev` — tylko lokalny podgląd UI.
# Nie używaj tych wartości w produkcji. Do prawdziwej bazy skopiuj `.env.example` → `.env.local`.

VITE_FIREBASE_API_KEY=demo-api-key
VITE_FIREBASE_AUTH_DOMAIN=demo-cyber-ponk.firebaseapp.com
VITE_FIREBASE_DATABASE_URL=https://demo-cyber-ponk-default-rtdb.europe-west1.firebasedatabase.app
VITE_FIREBASE_PROJECT_ID=demo-cyber-ponk
VITE_FIREBASE_STORAGE_BUCKET=demo-cyber-ponk.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:00000000000000000000
VITE_BLIK_NUMBER=600 000 000
