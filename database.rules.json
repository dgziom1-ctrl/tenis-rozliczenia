{
  "rules": {
    ".read": false,
    ".write": false,

    "appData": {
      ".read": true,
      ".write": true,

      "players": {
        "$index": {
          ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 40"
        }
      },

      "deletedPlayers": {
        "$index": {
          ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 40"
        }
      },

      "defaultMultiPlayers": {
        "$index": {
          ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 40"
        }
      },

      "playerJoinWeek": {
        "$playerName": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100000"
        }
      },

      "weeks": {
        "$index": {
          ".validate": "newData.hasChildren(['id', 'date', 'cost', 'present'])",

          "id":   { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 64" },
          "date": { ".validate": "newData.isString() && newData.val().matches(/^[0-9]{4}-[0-9]{2}-[0-9]{2}$/)" },
          "cost": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100000" },

          "sport": {
            ".validate": "newData.isString() && (newData.val() === 'pingpong' || newData.val() === 'squash' || newData.val() === 'badminton')"
          },

          "present": {
            ".validate": "newData.hasChildren()",
            "$i": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 40" }
          },
          "multiPlayers": {
            "$i": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 40" }
          },
          "ownRacketPlayers": {
            "$i": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 40" }
          },
          "overtimePlayers": {
            "$i": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 40" }
          },

          "racketCost":  { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100000" },
          "overtimeCost": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100000" },

          "$other": { ".validate": false }
        }
      },

      "payments": {
        "$playerName": {
          "$index": {
            ".validate": "newData.hasChildren(['id', 'amount', 'date'])",

            "id":     { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 64" },
            "amount": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100000" },
            "date":   { ".validate": "newData.isString() && newData.val().matches(/^[0-9]{4}-[0-9]{2}-[0-9]{2}$/)" },

            "$other": { ".validate": false }
          }
        }
      },

      "lastAddedSession": {
        "id": { ".validate": "newData.isString() && newData.val().length <= 64" },
        "ts": { ".validate": "newData.isNumber()" },
        "$other": { ".validate": false }
      },

      "paidUntilWeek": {
        "$playerName": { ".validate": "newData.isNumber() && newData.val() >= 0" }
      },

      "$other": { ".validate": false }
    },

    "fcmTokens": {
      "$tokenKey": {
        ".read": true,
        ".write": true,
        ".validate": "newData.hasChildren(['token'])",

        "token":      { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 4096" },
        "playerName": { ".validate": "newData.isString() && newData.val().length <= 40" },
        "updatedAt":  { ".validate": "newData.isNumber()" },
        "ua":         { ".validate": "newData.isString() && newData.val().length <= 100" },

        "$other": { ".validate": false }
      }
    }
  }
}
